# Local Docker Compose PostgreSQL settings (use private hosting secrets in production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=thesishub
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/thesishub?schema=public

# Generate a strong, random signing secret before publishing the app
JWT_SECRET=replace-with-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=3000
